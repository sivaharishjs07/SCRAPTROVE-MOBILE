# Mobile app config. Copy to .env and fill (never commit .env).
# Reads via expo-constants at runtime.

# API base URL — the staging worker for review, prod worker for production build.
EXPO_PUBLIC_API_URL=https://scraptrove-api-staging.workers.dev

# ── Build-time only (do not need at runtime) ────────────────────────────
# EXPO_TOKEN=  # only needed for automated `eas build --local` in CI
